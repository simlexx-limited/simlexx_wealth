# --- Postgres ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# --- Redis (cache + Celery broker/result backend) ---
REDIS_URL=
REDIS_MAX_CONNECTIONS=
REDIS_SOCKET_TIMEOUT=
REDIS_MAX_RETRIES=
MAX_WORKERS=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=

# --- OPEN ROUTER KEY and GOOGLE ADK ---
OPENROUTER_KEY=
LLM_MODEL=
LLM_ENABLED=
ADK_SUPPRESS_GEMINI_LITELLM_WARNINGS=
LLM_MAX_RETRIES=
LLM_RETRY_DELAY=

# --- Web search
TAVILY_SEARCH_API=
SEARCH_DEPTH=

# --- CLOUDFLARE S3 Bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_JURISDICTION=

# Signed links to uploaded files (ID documents, pictures) stay valid this long
SIGNED_URL_EXPIRE_SECONDS=900

# --- Firebase
PATH_TO_FIREBASE=
FIREBASE_WEB_API=

# JWT Key
SECRET_ACCESS_KEY=
ALGORITHM=
JWT_EXPIRE_MINUTES=
# Administrators get a shorter session
ADMIN_JWT_EXPIRE_MINUTES=15

# --- SMTP (email service)
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=
SMTP_FROM_EMAIL=

# --- OTP
OTP_TTL_SECONDS=

# --- Rate limiting
OTP_ATTEMPT_LIMIT=
OTP_ATTEMPT_WINDOW_SECONDS=

# --- Login lockout (failed password attempts per window, then locked until it ends)
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_IP_MAX_FAILED_ATTEMPTS=20
LOGIN_LOCKOUT_SECONDS=900

# --- Countries we serve (ISO alpha-2, comma-separated, e.g. UG,RW)
SERVED_COUNTRIES=

# --- Roles allowed to self-register (agents and admins are created by a Simlexx admin)
SELF_REGISTRATION_ROLES=User
